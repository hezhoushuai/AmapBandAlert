<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="AmapBandAlert" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="高德限速拍照 → 手环震动" android:textSize="14sp" android:paddingBottom="16dp"/>

    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="状态: 未启动"
        android:textSize="16sp" android:paddingBottom="20dp"/>

    <Button android:id="@+id/btn_start" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="启动监听服务"/>

    <Button android:id="@+id/btn_test" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="发送测试通知(验证手环链路)"/>

    <TextView android:id="@+id/label_dist" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="预警距离: 300m"
        android:paddingTop="24dp" android:textSize="16sp"/>
    <SeekBar android:id="@+id/bar_dist" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ToggleButton android:id="@+id/toggle_camera" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textOn="电子眼提醒: 开"
        android:textOff="电子眼提醒: 关" android:checked="true" android:paddingTop="12dp"/>

    <ToggleButton android:id="@+id/toggle_speed" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textOn="超速提醒: 开"
        android:textOff="超速提醒: 关" android:checked="true"/>
</LinearLayout>
