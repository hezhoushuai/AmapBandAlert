<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0E1116">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AmapBandAlert"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v0.4.0 · 高德导航 → 小米手环 9 Pro 场景提醒"
            android:textColor="#8B98A9"
            android:textSize="13sp"
            android:paddingTop="2dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#171C24"
            android:padding="16dp">

            <TextView
                android:id="@+id/status_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 未启动"
                android:textColor="#FFB74D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="等待高德导航…"
                android:textColor="#E6EDF5"
                android:textSize="15sp"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/source_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="尚未收到高德数据"
                android:textColor="#8B98A9"
                android:textSize="12sp"
                android:paddingTop="5dp" />

            <TextView
                android:id="@+id/raw_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="（原始通知为空）"
                android:textColor="#66717F"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="6"
                android:ellipsize="end"
                android:paddingTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="启动监听"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="测试手环通知（先验证转发）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#37474F" />

        <Button
            android:id="@+id/btn_test_turn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="模拟一次左转提醒"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#37474F" />

        <Button
            android:id="@+id/btn_test_speed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="模拟超速 82/60（测试手环）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#8E3B00" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="立即读取高德通知（诊断）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#37474F" />

        <Button
            android:id="@+id/btn_capture_ui"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="记录高德界面文字 60 秒（诊断限速）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#37474F" />

        <Button
            android:id="@+id/btn_log"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="运行日志"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#37474F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="权限"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btn_listener"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="通知使用权：去开启（必需）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#B26A00" />

        <Button
            android:id="@+id/btn_notif_perm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="通知权限：去允许（必需）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#B26A00" />

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="电池优化：去设置（骑行保活）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#37474F" />

        <Button
            android:id="@+id/btn_location"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="定位权限：去允许（超速需要）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#B26A00" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="高德界面限速：去开启（实验性）"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#37474F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提醒场景"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/label_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转向提醒距离：200 米"
            android:textColor="#C7D0DB"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/bar_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/toggle_turn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:text="转向提醒（左转 / 右转 / 掉头 / 环岛）"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/toggle_near"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="临近 50 米再补一次提醒"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/toggle_arrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="到达 / 导航结束提醒"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/toggle_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="导航开始时提醒"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/toggle_keyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="关键词提醒（拥堵 / 事故 / 拍照，实验性）"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/toggle_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="电子眼提醒（仅高德车机版广播）"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超速提醒"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="26dp"
            android:paddingBottom="4dp" />

        <Switch
            android:id="@+id/toggle_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="超速提醒总开关（GPS / 车机广播 / 固定阈值）"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/label_fixed_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="固定限速阈值：60 km/h（没有道路限速时使用）"
            android:textColor="#C7D0DB"
            android:textSize="14sp"
            android:paddingTop="4dp" />

        <SeekBar
            android:id="@+id/bar_fixed_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/toggle_fixed_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="没有道路限速时，使用上面的固定阈值"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="超速数据优先级：高德车机版广播（真实车速+真实限速，最准）＞ GPS 车速 + 高德界面限速（实验性）＞ GPS 车速 + 固定阈值。手机版高德不提供道路限速，所以要么装高德车机版导航，要么开启固定阈值，要么试试无障碍读取界面限速。"
            android:textColor="#66717F"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重要：手机版高德不发送车机版广播，本应用通过“通知使用权”读取高德导航通知。请先在小米运动健康中开启本应用的通知转发，再用上面的测试按钮确认手环会震动。"
            android:textColor="#66717F"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</ScrollView>
