<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amapbandalert">
<application
        android:label="AmapBandAlert"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AmapBandAlert">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service android:name=".MonitorService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="listening_amap_navigation_broadcast"/>
        </service>

        <receiver android:name=".AmapBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="AUTONAVI_STANDARD_BROADCAST_SEND"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
